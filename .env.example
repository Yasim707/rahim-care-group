# Rahim Care Group — contact form email delivery (server-side only).
# Copy this file to `.env` for local development and set the real values.
# Never commit `.env` or real keys. In production, set these in the Vercel
# project's Environment Variables, not in the repository.

# Resend API key (server-side only, never exposed to the browser).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where enquiries are delivered.
CONTACT_TO_EMAIL=admin@rahimcaregroup.com

# The "from" address. MUST be on a domain verified in Resend
# (for example: enquiries@rahimcaregroup.com). Do not use a random address.
CONTACT_FROM_EMAIL=enquiries@rahimcaregroup.com
